# Documentation only: Go reads the process environment, not this file.
APP_ENV=local
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=./data/bakafactory.local.db
LOG_LEVEL=info
APP_VERSION=0.1.0
# Login lifetime; opening or refreshing the page renews a valid session.
SESSION_TTL=720h
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# Enable built web hosting (relative to apps/server):
# WEB_DIST_DIR=../web/dist
