{
  "name": "@bakafactory/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/generate-search-index.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/generate-search-index.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "node ../../scripts/generate-search-index.mjs --check && node ../../scripts/check-ui-typography.mjs && node ../../scripts/check-game-font.mjs && node ../../scripts/check-item-sprites.mjs && node ../../scripts/check-building-art.mjs && eslint . && tsc --noEmit",
    "pretest": "node ../../scripts/generate-search-index.mjs",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../docs/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  }
}
